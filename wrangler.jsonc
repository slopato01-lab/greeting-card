{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "greeting-card",
  // Проект Cloudflare Pages, а не воркер: сюда попадает статический
  // экспорт Next из out/. Привязки и секреты появятся вместе
  // с серверной частью, тогда же пересматриваем сам способ хостинга.
  "pages_build_output_dir": "out",
}
