# Имена переменных без значений. Значения — только в .dev.vars локально
# и в секретах Cloudflare/GitHub на сервере. См. docs/SECURITY.md.

# Базовый адрес сайта, нужен для абсолютных ссылок и QR
NEXT_PUBLIC_SITE_URL=

# Платежи bePaid. Вызываются только с сервера.
# Открытка создаётся по вебхуку, подпись проверяется до любых действий.
BEPAID_SHOP_ID=
BEPAID_SECRET_KEY=
BEPAID_WEBHOOK_SECRET=

# Хранилище фотографий (R2). Прямой доступ к бакету закрыт,
# раздача только по подписанным URL со сроком жизни 1 час.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Turnstile: защита создания открытки и оплаты от автоматизации
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ИИ-сервис. Провайдер ещё не выбран, имя переменной предварительное.
# Ключ вызывается только с сервера.
AI_API_KEY=

# База данных. Движок не выбран: если это будет D1, переменная не нужна —
# там привязка в wrangler.jsonc. До решения строка остаётся заглушкой.
DATABASE_URL=
